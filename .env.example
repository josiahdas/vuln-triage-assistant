# Copy to .env and fill in
ANTHROPIC_API_KEY=your_key_here

# NVD API key is optional but strongly recommended (higher rate limits)
# Get one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# SQLite by default; swap for Postgres URL if you want to show that skill too
DATABASE_URL=sqlite:///./data/vulns.db

# Vector store location
CHROMA_PERSIST_DIR=./data/chroma
